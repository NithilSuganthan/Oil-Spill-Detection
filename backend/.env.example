# ---- Application ----
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ---- Database ----
# Production: PostgreSQL + PostGIS
# DATABASE_URL=postgresql+psycopg2://sagar:sagar@localhost:5432/sagarwatch
# Leave unset to use the in-memory development repository (no persistence).
DATABASE_URL=

# Set true to auto-seed demo data at startup when the database is empty.
SEED_DEMO_DATA=true

# ---- Model adapter ----
# "mock"  -> deterministic development heuristic (NOT a trained model)
# "torch" -> reserved for the trained PyTorch model (see docs/ml-integration-contract.md)
MODEL_ADAPTER=mock
MODEL_PATH=/models/oil_spill/model.pth
MODEL_NAME=OilSpillNet
MODEL_VERSION=1.0-dev
MODEL_DEVICE=cpu
MODEL_THRESHOLD=0.5

# ---- Inference post-processing ----
MIN_POLY_AREA_KM2=0.05
POLYGON_SIMPLIFY_TOLERANCE_M=25

# ---- Scene storage ----
SCENE_STORAGE_DIR=./data/scenes

# ---- Real Sentinel-1 GRD preprocessing (Phase 2C) -----------------------
# Scientifically neutral defaults: native 10 m preserved; thermal-noise
# removal OFF until the ML contract decides the final input representation.
# GRD_TARGET_CRS=EPSG:4326
# GRD_TARGET_RESOLUTION_M=10
# GRD_RESAMPLING=bilinear
# GRD_APPLY_NOISE_REMOVAL=false
# GRD_GCP_POLY_ORDER=3

# ---- Satellite ingestion (Phase 2) --------------------------------------
# mock | copernicus ; CDSE credentials via CDSE_USERNAME / CDSE_PASSWORD
# SATELLITE_PROVIDER=mock
# INDIA_AOI_BBOX=68.0,6.0,94.5,24.5

# ---- AIS vessel correlation (Phase 4) -----------------------------------
# "mock"  -> deterministic synthetic demo vessels
# "gfw"   -> Global Fishing Watch 4Wings API (requires GFW_API_TOKEN)
# AIS_PROVIDER=mock
# GFW_API_TOKEN=                   # env-only; never hardcode
# AIS_SEARCH_RADIUS_KM=50.0
# AIS_TIME_WINDOW_HOURS=6.0
# AIS_DISTANCE_WEIGHT=0.50
# AIS_TIME_WEIGHT=0.30
# AIS_TRACK_WEIGHT=0.20

# ---- Drift / hindcast (Phase 5) ------------------------------------------
# DRIFT_PROVIDER=mock              # mock | first_order
# ENVIRONMENTAL_PROVIDER=mock      # mock | real
# DRIFT_HOURS=24.0                 # backward integration window
# DRIFT_TIMESTEP_MINUTES=15.0
# DRIFT_ENSEMBLE_SIZE=50
# WINDAGE_COEFFICIENT=0.03
# WINDAGE_COEFFICIENT_STD=0.01
# CURRENT_FRACTION=1.0
# POSITION_NOISE_KM=0.5
# DRIFT_UNCERTAINTY_KM_PER_HOUR=0.5

# ---- Phase 7: Real Environmental Data (CMEMS + ERA5) ---------------------
# "mock" = deterministic synthetic forcing (default, development/testing)
# "real"  = CMEMS GLOBCurrents + ERA5 winds (requires credentials below)
# ENVIRONMENTAL_PROVIDER=mock

# Copernicus Marine Service (CMEMS) — register free at https://marine.copernicus.eu/
# Username and password for the copernicusmarine Python toolbox.
# CMEMS_USERNAME=
# CMEMS_PASSWORD=

# ECMWF Climate Data Store (CDS) — register free at https://cds.climate.copernicus.eu/
# Personal access token for the cdsapi Python client.
# After registering, accept the ERA5 dataset licence on the dataset page.
# CDS_API_KEY=
# CDS_API_URL=https://cds.climate.copernicus.eu/api

# Caching / bbox padding for environmental data
# ENV_CACHE_BBOX_PAD_DEG=0.5
# ENV_CACHE_TEMPORAL_PAD_HOURS=1.0

# ---- Phase 9: Groq Investigation Reports ----
# Groq API key for natural-language report generation.
# Register at https://console.groq.com/ — never commit real keys.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
